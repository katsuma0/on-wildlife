{
  "name": "Ontario Wildlife Log",
  "short_name": "Wildlife Log",
  "description": "A simple, iOS-style field journal for logging Ontario's wildlife, fish, plants, trees, insects and fungi.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f2f2f7",
  "theme_color": "#14804a",
  "categories": ["lifestyle", "utilities", "education"],
  "icons": [
    { "src": "icons/icon.svg", "type": "image/svg+xml", "sizes": "any", "purpose": "any" },
    { "src": "icons/icon-192.png", "type": "image/png", "sizes": "192x192", "purpose": "any maskable" },
    { "src": "icons/icon-512.png", "type": "image/png", "sizes": "512x512", "purpose": "any maskable" }
  ]
}
